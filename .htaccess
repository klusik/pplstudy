# PPL Study Apache rules for shared-hosting deployment.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose implementation, source data, migrations, cache, or scripts.
    RewriteRule ^(?:app|database|data|scripts|cache)(?:/|$) - [F,L,NC]

    # Existing public assets and utility entry points are served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is routed through the root front controller.
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "^(?:config\.php|\.env|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(?:md|sql|log|ini|lock|sh|bat|ps1)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
