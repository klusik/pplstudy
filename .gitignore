# Local application configuration and secrets
/config.php
/.env
/.env.*
!/.env.example

# Runtime-generated state
/cache/*
!/cache/.gitkeep
*.log
*.tmp

# Generated deployment output and local source PDFs
/deploy/*
!/deploy/.gitkeep
/data/source-documents/*.pdf

# Python tooling artifacts
__pycache__/
*.py[cod]

# Test and coverage output
/.phpunit.cache/
/coverage/

# Editor and operating-system metadata
/.idea/
/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
